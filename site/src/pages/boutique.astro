---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Boutique - LowSens" bodyClass="shop-page">
    <section class="hero shop-hero">
        <h1>La boutique</h1>
        <p class="subtitle">Equipez vous de la <strong>Sens touch</strong> avec notre boutique officielle !</p>

        <div class="shop-container">
            <div class="product-card">
                <div class="product-image-container">
                    <img src="img/maillot_blanc.svg" alt="Maillot LowSens - Blanc" />
                </div>
                <h2 class="product-name">Maillot LowSens – Blanc</h2>
                <p class="product-desc">Pour rayonner dans le monde entier</p>
                <span class="product-price">34,99 €</span>
                <a href="https://eliminate.fr/produit/team-sens-jersey-2026/" target="_blank" rel="noopener noreferrer" class="btn-buy">Acheter *</a>
            </div>

            <div class="product-card">
                <div class="product-image-container">
                    <img src="img/maillot_noir.svg" alt="Maillot LowSens - Noir" />
                </div>
                <h2 class="product-name">Maillot LowSens – Noir</h2>
                <p class="product-desc">Montrez de quoi vous êtes capable</p>
                <span class="product-price">34,99 €</span>
                <a href="https://eliminate.fr/produit/team-sens-jersey-2026/" target="_blank" rel="noopener noreferrer" class="btn-buy">Acheter *</a>
            </div>
        </div>

        <p class="small-print">Acheter via la plateforme yokoesport*</p>
    </section>
</Layout>

