<section class="hero">
    <h1>Bienvenue sur le site officiel de LowSens !</h1>

    <div class="widgets-container">
        <div class="widget news">
            <h2>Actualités</h2>

            <div class="slider-content" id="news-slider">
                <img src="img/logo.jpg" alt="Image Actu" id="news-img" />
                <p id="news-desc">Bienvenue sur notre site officiel #SensTouch</p>
            </div>

            <div class="slider-nav" id="news-dots"></div>
        </div>

        <div class="widget matches">
            <h2>Prochains matchs</h2>

            <div class="slider-content" id="match-slider">
                <div class="match-info">
                    <img src="img/logo-seul.png" alt="Team A" class="team-logo" id="match-team-a" />

                    <div class="match-details">
                        <span id="match-date">22/09</span>
                        <span id="match-heure">21h</span>
                    </div>

                    <img src="img/logo-seul.png" alt="Team B" class="team-logo" id="match-team-b" />
                </div>
                <p class="game-type" id="match-game">Valorant</p>
            </div>

            <div class="slider-nav" id="match-dots"></div>
        </div>

        <div class="widget result">
            <h2>Dernier résultat</h2>
            <div class="result-info">
                <img src="img/logo-seul.png" alt="LowSens" class="team-logo" />
                <span class="team-name">LowSens</span>
                <span class="score">3 - 1</span>
                <span class="team-name">Team Sang</span>
                <img src="img/logo-seul.png" alt="Team Sang" class="team-logo" />
            </div>
            <p class="game-type">Valorant</p>
        </div>
    </div>
</section>

<script>
    const API_BASE = "/api";
    const FALLBACK_API_BASE = "http://127.0.0.1:3000/api";

    const newsData = [
        {
            img: "img/logo.jpg",
            desc: "Bienvenue sur notre site officiel #SensTouch"
        },
        {
            img: "img/maillot_blanc.svg",
            desc: "LowSens remporte le tournoi d'hiver !"
        },
        {
            img: "img/valorant.png",
            desc: "Les recrutements sont ouverts pour le roster Valorant."
        }
    ];

    const fallbackMatchesData = [
        {
            teamA: "img/logo-seul.png",
            teamB: "img/logo-seul.png",
            date: "22/09",
            heure: "21h",
            jeu: "Valorant"
        },
        {
            teamA: "img/logo-seul.png",
            teamB: "img/logo-seul.png",
            date: "25/09",
            heure: "20h30",
            jeu: "Rocket League"
        }
    ];

    async function getMatchesData() {
        try {
            let response = await fetch(`${API_BASE}/matches`);
            if (!response.ok) {
                response = await fetch(`${FALLBACK_API_BASE}/matches`);
            }
            if (!response.ok) {
                return fallbackMatchesData;
            }

            const data = await response.json();
            if (!Array.isArray(data) || data.length === 0) {
                return fallbackMatchesData;
            }

            return data.map((item) => {
                const dateText = typeof item.date === "string" ? item.date : "";
                const [datePart, heurePart] = dateText.split(" ", 2);
                return {
                    teamA: item.teamA || "img/logo-seul.png",
                    teamB: item.teamB || "img/logo-seul.png",
                    date: datePart || dateText || "A definir",
                    heure: heurePart || "A definir",
                    jeu: item.jeu || "Inconnu"
                };
            });
        } catch (_) {
            return fallbackMatchesData;
        }
    }

    function setupSlider(data: any[], containerType: "news" | "match") {
        let currentIndex = 0;

        const dotsContainer = document.getElementById(`${containerType}-dots`);
        const contentContainer = document.getElementById(`${containerType}-slider`);
        if (!dotsContainer || !contentContainer) return;

        dotsContainer.innerHTML = "";
        data.forEach((_, index) => {
            const dot = document.createElement("span");
            dot.classList.add("dot");
            if (index === 0) dot.classList.add("active");

            dot.addEventListener("click", () => {
                currentIndex = index;
                updateDisplay(currentIndex);
                resetAutoSlide();
            });

            dotsContainer.appendChild(dot);
        });

        function updateDisplay(index: number) {
            if (!contentContainer || !dotsContainer) return;
            contentContainer.classList.remove("fade-anim");
            void contentContainer.offsetWidth;
            contentContainer.classList.add("fade-anim");

            if (containerType === "news") {
                const imgEl = document.getElementById("news-img") as HTMLImageElement | null;
                const descEl = document.getElementById("news-desc");
                if (imgEl) imgEl.src = data[index].img;
                if (descEl) descEl.textContent = data[index].desc;
            } else if (containerType === "match") {
                const teamAEl = document.getElementById("match-team-a") as HTMLImageElement | null;
                const teamBEl = document.getElementById("match-team-b") as HTMLImageElement | null;
                const dateEl = document.getElementById("match-date");
                const heureEl = document.getElementById("match-heure");
                const gameEl = document.getElementById("match-game");
                if (teamAEl) teamAEl.src = data[index].teamA;
                if (teamBEl) teamBEl.src = data[index].teamB;
                if (dateEl) dateEl.textContent = data[index].date;
                if (heureEl) heureEl.textContent = data[index].heure;
                if (gameEl) gameEl.textContent = data[index].jeu;
            }

            const dots = dotsContainer.querySelectorAll(".dot");
            dots.forEach((d) => d.classList.remove("active"));
            if (dots[index]) dots[index].classList.add("active");
        }

        let autoSlideInterval: ReturnType<typeof setInterval>;

        function startAutoSlide() {
            autoSlideInterval = setInterval(() => {
                currentIndex = (currentIndex + 1) % data.length;
                updateDisplay(currentIndex);
            }, 5000);
        }

        function resetAutoSlide() {
            clearInterval(autoSlideInterval);
            startAutoSlide();
        }

        updateDisplay(0);
        startAutoSlide();
    }

    if (document.getElementById("news-slider")) {
        setupSlider(newsData, "news");
    }

    if (document.getElementById("match-slider")) {
        getMatchesData().then((matches) => {
            setupSlider(matches, "match");
        });
    }
</script>

